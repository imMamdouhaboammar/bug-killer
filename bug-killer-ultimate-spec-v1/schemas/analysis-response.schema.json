{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-response.schema.json",
  "title": "Bug Killer Analysis Response v1 (PROPOSED)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "engine_id",
    "engine_version",
    "snapshot_sha256",
    "status",
    "findings",
    "receipts",
    "diagnostics",
    "resources",
    "completed_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "engine_id": { "type": "string", "minLength": 1 },
    "engine_version": { "type": "string", "minLength": 1 },
    "snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": {
      "type": "string",
      "enum": ["COMPLETED", "PARTIAL", "ERROR", "BLOCKED", "CANCELLED"]
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "finding.schema.json" }
    },
    "receipts": {
      "type": "array",
      "items": { "$ref": "coverage-receipt.schema.json" }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "target_id": { "type": ["string", "null"] }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "peak_memory_bytes"],
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 0 },
        "peak_memory_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "description": "The orchestrator MUST verify consistency against the request and prevent self-reported completion from bypassing mandatory receipts."
}
