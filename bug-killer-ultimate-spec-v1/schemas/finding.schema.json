{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "Bug Killer Finding v1 (PROPOSED)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "finding_id",
    "kind",
    "status",
    "title",
    "severity",
    "evidence_certainty",
    "engine",
    "target",
    "source_snapshot_sha256",
    "evidence",
    "coverage_receipt_ids",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "finding_id": { "type": "string", "minLength": 1 },
    "fingerprint": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["KNOWN_ADVISORY", "CATALOG", "RESEARCH_CANDIDATE"]
    },
    "status": {
      "type": "string",
      "enum": [
        "SUSPECTED",
        "VERSION_AFFECTED",
        "REACHABILITY_SUSPECTED",
        "REPRODUCED",
        "VERIFIED",
        "DUPLICATE_KNOWN",
        "FALSE_POSITIVE",
        "INCONCLUSIVE",
        "BLOCKED",
        "FIX_PROPOSED",
        "FIXED_VERIFIED"
      ]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "summary": { "type": "string", "maxLength": 5000 },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO", "UNKNOWN"]
    },
    "evidence_certainty": {
      "type": "string",
      "enum": ["UNKNOWN", "PATTERN_INDICATOR", "SUSPECTED", "STRONGLY_SUPPORTED", "CONFIRMED"]
    },
    "rule_id": { "type": ["string", "null"] },
    "weakness_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CWE-[0-9]+$" },
      "uniqueItems": true
    },
    "advisory_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "rule_pack_sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "rule_pack_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "kind"],
      "properties": {
        "target_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["FILE", "PACKAGE", "BINARY", "SERVICE", "CONFIG", "WORKSPACE"] },
        "path": { "type": "string" },
        "package_purl": { "type": "string" },
        "version": { "type": "string" },
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_line", "end_line"],
          "properties": {
            "start_line": { "type": "integer", "minimum": 1 },
            "end_line": { "type": "integer", "minimum": 1 },
            "start_column": { "type": "integer", "minimum": 1 },
            "end_column": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "source_snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "proof": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "artifact_sha256", "reproduced_on_snapshot"],
          "properties": {
            "method": {
              "type": "string",
              "enum": ["ISOLATED_TEST", "AUTHORITATIVE_RANGE", "STATIC_INVARIANT", "RUNTIME_TRACE", "REPRODUCTION_ARTIFACT"]
            },
            "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "reproduced_on_snapshot": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "limitations": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "coverage_receipt_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "uncertainty_reasons": { "type": "array", "items": { "type": "string" } },
    "remediation_plan_id": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "extensions": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "evidence_certainty": { "const": "CONFIRMED" } },
        "required": ["evidence_certainty"]
      },
      "then": {
        "required": ["proof"],
        "properties": { "proof": { "type": "object" } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "FIXED_VERIFIED" } },
        "required": ["status"]
      },
      "then": {
        "required": ["remediation_plan_id"],
        "properties": { "remediation_plan_id": { "type": "string", "minLength": 1 } }
      }
    }
  ],
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifact_sha256", "description"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["SOURCE_SPAN", "AST_MATCH", "DATAFLOW_TRACE", "ADVISORY_MATCH", "TEST_REPRODUCTION", "RUNTIME_TRACE", "OTHER"]
        },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "description": { "type": "string", "maxLength": 2000 },
        "reference": { "type": ["string", "null"] },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
