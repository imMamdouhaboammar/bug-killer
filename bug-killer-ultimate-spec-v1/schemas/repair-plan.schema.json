{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repair-plan.schema.json",
  "title": "Bug Killer Repair Plan v1 (PROPOSED)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "run_id",
    "finding_ids",
    "workspace_root_digest",
    "risk_level",
    "proposed_actions",
    "required_verifications",
    "status",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "plan_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "finding_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "workspace_root_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "risk_level": { "type": "string", "enum": ["L1", "L2", "L3", "L4"] },
    "proposed_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "kind", "target_relative_path", "preimage_sha256", "expected_postimage_sha256"],
        "properties": {
          "action_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["SOURCE_PATCH", "LOCKFILE_UPDATE", "CONFIG_PATCH", "WAF_RULE", "PACKAGE_UPGRADE"] },
          "target_relative_path": { "type": "string", "minLength": 1 },
          "preimage_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "expected_postimage_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "diff_artifact_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "required_verifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verification_id", "kind"],
        "properties": {
          "verification_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["PARSER", "FORMAT", "TYPECHECK", "BUILD", "TEST", "SECURITY_RESCAN", "SERVICE_HEALTH", "DEPENDENCY_REQUERY"] },
          "required": { "type": "boolean" }
        }
      }
    },
    "approval": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["operator_id", "approval_id", "plan_digest", "issued_at", "expires_at", "signature_ref"],
      "properties": {
        "operator_id": { "type": "string" },
        "approval_id": { "type": "string" },
        "plan_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "signature_ref": { "type": "string" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["PROPOSED", "REVIEWED", "AUTHORIZED", "STAGED", "APPLIED", "VERIFIED", "FAILED", "ROLLED_BACK", "RECOVERY_REQUIRED"]
    },
    "backup_manifest_ref": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["AUTHORIZED", "STAGED", "APPLIED", "VERIFIED"] } },
        "required": ["status"]
      },
      "then": {
        "required": ["approval"],
        "properties": { "approval": { "type": "object" } }
      }
    }
  ],
  "description": "Consumer MUST reject absolute paths, traversal, symlinks, invalid signatures and drift at use time; JSON Schema alone does not grant authorization."
}
