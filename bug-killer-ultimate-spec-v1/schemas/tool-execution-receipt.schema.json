{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-execution-receipt.schema.json",
  "title": "Bug Killer Tool Execution Receipt v1 (PROPOSED)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "plan_id", "run_id", "tool_id", "adapter_version", "engine_version", "snapshot_sha256", "target_ids", "check_ids", "status", "reason_code", "authorization_ref", "resources", "artifacts", "started_at", "completed_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "tool_id": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "engine_version": { "type": ["string", "null"] },
    "snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "check_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["COMPLETED", "PARTIAL", "NOT_RUN", "BLOCKED", "ERROR", "CANCELLED"] },
    "reason_code": { "type": "string", "minLength": 1 },
    "authorization_ref": { "type": ["string", "null"] },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "peak_memory_bytes", "cost_estimate_usd", "cost_actual_usd"],
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 0 },
        "peak_memory_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "cost_estimate_usd": { "type": ["number", "null"], "minimum": 0 },
        "cost_actual_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "sha256", "access_class"],
        "properties": {
          "kind": { "enum": ["RAW_OUTPUT", "NORMALIZED_FINDINGS", "COVERAGE", "TEST_PROOF", "SANITIZED_DIAGNOSTICS"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "access_class": { "enum": ["LOCAL_REDACTED", "PRIVATE_RESTRICTED"] },
          "storage_ref": { "type": ["string", "null"] }
        }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "description": "A host-authored execution fact, including skipped or denied work. It is not an analysis CoverageReceipt and cannot self-assert a finding's certainty."
}
