{
  "evals": [
    {
      "id": "trigger-launch-lat",
      "prompt": "Launch lat.md and initialize a knowledge graph for this project",
      "assertions": [
        {
          "pattern": "lat init",
          "required": true
        },
        {
          "pattern": "lat check",
          "required": true
        }
      ]
    },
    {
      "id": "trigger-create-lats",
      "prompt": "Create lats for our authentication and billing modules and anchor the source code",
      "assertions": [
        {
          "pattern": "lat.md/",
          "required": true
        },
        {
          "pattern": "@lat:",
          "required": true
        },
        {
          "pattern": "lat check",
          "required": true
        }
      ]
    },
    {
      "id": "trigger-validate-repair",
      "prompt": "Run lat check, find any missing leading paragraphs or broken links, and fix them",
      "assertions": [
        {
          "pattern": "lat check",
          "required": true
        },
        {
          "pattern": "250",
          "required": true
        }
      ]
    },
    {
      "id": "trigger-configure-mcp",
      "prompt": "Configure the lat MCP server and hooks for Cursor and Claude Code",
      "assertions": [
        {
          "pattern": "lat mcp",
          "required": true
        },
        {
          "pattern": "mcpServers",
          "required": true
        }
      ]
    },
    {
      "id": "negative-generic-coding",
      "prompt": "Write a Python script to sort an array using quicksort",
      "assertions": [
        {
          "pattern": "lat init",
          "required": false
        }
      ]
    },
    {
      "id": "negative-cloud-deploy",
      "prompt": "Deploy my Kubernetes cluster to Google Cloud GKE",
      "assertions": [
        {
          "pattern": "lat.md",
          "required": false
        }
      ]
    }
  ]
}
