_bug-killer_commands() {
    local commands; commands=(
'shell:Launch the interactive Bug Killer REPL shell' \
'doctor:Run diagnostic system and environment health audit' \
'watch:Start live surveillance monitoring filesystem for security regressions' \
'completion:Generate shell auto-completion script for bash, zsh, fish, or powershell' \
'scan:Scan target directories and systems for PHP2Shell (CVE-2026-109618, CVE-2026-109619) and Node2Shell (CVE-2026-111497)' \
'probe:Defensively probe a live web application endpoint for security posture, headers, and disclosures' \
'osv:Query open-source vulnerability database (https\://osv.dev) for dependencies across npm, Packagist, PyPI, and crates.io' \
'heal:Plan and automatically heal vulnerable configurations, Dockerfiles, manifests, and web servers' \
'rollback:Roll back an applied healing session using a backup ID' \
'history:List all healing snapshots and backups' \
'cve-info:Display deep technical teardown and remediation blueprint for a specific CVE' \
'agent:Model-agnostic AI agent investigation and capability diagnostics' \
'evidence:Retrieve full evidence receipts and cryptographic hashes for a specific finding' \
'plan:Plan a prospective, non-mutating repair for a finding with cryptographic diff hash' \
'approve:Issue an operator approval receipt for a planned remediation' \
'operator-public-key:Display the public key derived from a separately provisioned operator signing key' \
'apply:Apply an approved prospective remediation plan with operator approval verification' \
'mcp:Model Context Protocol (MCP) server and integration commands' \
'init:Initialize Bug Killer in a project, create security configuration, and run baseline scan' \
'security:Bug Killer Security Guard suite (scan, status, explain, fix, verify, guidance, catalog)' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'bug-killer commands' commands "$@"
}
